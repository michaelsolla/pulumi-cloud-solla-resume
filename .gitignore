# Dependencies
node_modules/

# Build output
dist/
bin/
*.tsbuildinfo

# Pulumi — stack configs may contain encrypted secrets; state is local-only
.pulumi/
Pulumi.*.yaml
!Pulumi.yaml
*.pulumi.backup

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
.secrets/

# Private keys and certificates
*.pem
*.p12
*.pfx
*.key
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# GCP credentials and local gcloud state
credentials.json
*-credentials.json
service-account*.json
gcp-*.json
*-sa.json
firebase-adminsdk*.json
client_secret*.json
oauth*.json
token.json
application_default_credentials.json
.gcloud/
.config/gcloud/

# Cloud and IaC artifacts that may contain sensitive data
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
.terraform.lock.hcl
cdk.out/

# Package manager auth (often contains registry tokens)
.npmrc
.yarnrc
.pnpm-store/

# Docker local overrides (may reference secrets or local paths)
docker-compose.override.yml
docker-compose.*.local.yml

# OS
.DS_Store
Thumbs.db

# Editors and IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Local Cursor / Pulumi agent skills (not part of the portfolio)
.agents/
skills-lock.json

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp/
temp/
