# Copy to .env and fill in values locally. Do not commit .env.

# GCP project and region
GCP_PROJECT=
GCP_REGION=us-central1

# Optional: path to a service account key JSON file (prefer ADC via gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=

# Pulumi stack name (when infrastructure code is added)
# PULUMI_STACK=dev
